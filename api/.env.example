# AKSAM API (Fastify) — copy to .env.

NODE_ENV=production
PORT=4000
API_HOST=0.0.0.0

# Comma-separated allowed CORS origins
CORS_ORIGINS=https://aksam.uz,https://admin.aksam.uz
# Allow *.pages.dev / *.trycloudflare.com / localhost preview origins
ALLOW_PREVIEW_ORIGINS=false

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/aksam?schema=public
# Redis (cache + rate limits)
REDIS_URL=redis://localhost:6379

# JWT auth — use long random strings
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# First superadmin (created by the seed script)
ADMIN_EMAIL=admin@aksam.uz
ADMIN_PASSWORD=

# Telegram order notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_ADMIN_CHAT_ID=

# ImgBB image hosting (admin uploads)
IMGBB_API_KEY=

LOG_LEVEL=info
